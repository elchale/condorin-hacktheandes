# Django
DJANGO_SECRET_KEY=
DEBUG=False
DOMAIN=api.condorin.pe
# Other hosts that serve the API, comma separated (e.g. the Cloud Run URL condorin-api-xxxx.a.run.app).
EXTRA_ALLOWED_HOSTS=
# Where the expediente pages live (the WhatsApp button opens FRONTEND_URL/expediente/<token>).
FRONTEND_URL=https://condorin.pe
# Extra browser origins allowed to call the API, comma separated (e.g. http://localhost:3000).
ADDITIONAL_CORS_ORIGINS=
# Origins as regexes, comma separated (e.g. Vercel previews: ^https://condorin-[a-z0-9-]+\.vercel\.app$).
CORS_ALLOWED_ORIGIN_REGEXES=

# Neon Postgres (pooled URL). Leave empty locally to use SQLite.
DATABASE_URL=
# Optional tuning: seconds a connection is reused, seconds to wait when connecting, the bound on the
# migrate the container runs at start, and how long GET /api/v1/mapa is kept in the process cache.
# DB_CONN_MAX_AGE=600
# DB_CONNECT_TIMEOUT=10
# MIGRATE_TIMEOUT=120
# MAPA_CACHE_SECONDS=30

# Detector webhook. Accepts either credential; empty disables that side.
DETECTIONS_SHARED_SECRET=
DETECTIONS_OIDC_AUDIENCE=https://api.condorin.pe/api/v1/detections
# Service accounts allowed to mint the Google ID token, comma separated.
DETECTIONS_ALLOWED_SERVICE_ACCOUNTS=
ALERT_MIN_CONFIDENCE=0.5
# Only scenes captured within this many days alert (ONG members and admins with a phone).
ALERT_RECENT_DAYS=7

# WhatsApp Cloud API, Qolca Solutions WABA (same values as condorin/.env.local).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ALERT_TEMPLATE=condorin_evento_v2
WA_CODE_TEMPLATE=condorin_codigo
WA_WELCOME_TEMPLATE=condorin_bienvenida
WA_TEMPLATE_LANG=es
# Sending is on when WA_TOKEN is set. Uncomment to only log messages instead.
# WA_SEND_ENABLED=False

# Google Cloud Storage, read access to the detector buckets.
# Base64 of the service account JSON; it needs a private key to sign the evidence links.
GCS_CREDENTIALS_JSON=
GCS_PROJECT_ID=
GCS_SIGNED_URL_MINUTES=60
# Bucket where the final PDFs are archived (the service account needs to create objects there).
GCS_EXPEDIENTES_BUCKET=

# Personal expediente links stay valid this many days.
ALERT_LINK_DAYS=60

# Email (Qolca SendGrid). Only the password (the SendGrid API key) is required.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Ojo de Cóndor <info@qolca.org>

# condorin.pe server to API (the /api/v1/panel routes). Same value as PANEL_API_SECRET in condorin.
PANEL_API_SECRET=
# How many days after delivery a WhatsApp alert link also signs the member in on condorin.pe.
LINK_SIGN_IN_DAYS=7
# TODO demo only: the ONG every new condorin.pe user joins (empty: the oldest active ONG).
# DEFAULT_ONG_ID=

# Redacción asistida de los hechos con Claude (LangChain). Apagada hasta que haya clave.
EXPEDIENTE_IA_ENABLED=False
# ANTHROPIC_API_KEY=
# EXPEDIENTE_IA_MODEL=claude-opus-5-5
